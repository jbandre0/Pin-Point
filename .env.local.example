# Copy to .env.local and fill in from Supabase → Settings → API.
# Both values are safe to expose to the browser; row-level security protects the data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Leave UNSET for local dev (site served from "/").
# The GitHub Pages workflow sets this to "/pinpoint" so assets resolve under
# jbandre0.github.io/pinpoint/. Do not set it in .env.local.
# NEXT_PUBLIC_BASE_PATH=/pinpoint
